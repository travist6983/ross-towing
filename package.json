{
  "name": "ross-towing",
  "private": true,
  "type": "module",
  "description": "Ross Towing website (Southfield, MI). Static site built with Vite, deployed to GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "gallery": "node scripts/build-gallery.mjs",
    "prebuild": "node scripts/build-gallery.mjs --quiet-if-missing",
    "build": "vite build",
    "postbuild": "node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "vite": "7.3.7"
  }
}
